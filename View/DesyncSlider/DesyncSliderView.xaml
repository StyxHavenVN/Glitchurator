<UserControl x:Class="StandalonePicturator.View.DesyncSlider.DesyncSliderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="920">

    <Grid Background="#242424" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Chọn Beatmap -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FFD54F" Text="Hitbox-Visual Desynchronizer (Quantum Slider)"/>
            <TextBlock Foreground="#B0BEC5" FontSize="11" Margin="0,2,0,5" 
                       Text="Separate the visible slider body from the interactive hitbox path."/>

            <Border Background="#1A2A2A" CornerRadius="4" Padding="5" BorderBrush="#00897B" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Beatmap (.osu):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#80CBC4" />
                    <TextBox Grid.Column="1" Text="{Binding BeatmapPath, UpdateSourceTrigger=PropertyChanged}" Background="White" Foreground="Black" Margin="5,0" Padding="4,2" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Choose map…" Command="{Binding Path=SelectBeatmapCommand}" Background="#00897B" Height="24"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Bảng tuỳ biến bên trái và Preview bên phải -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <!-- Khung Nạp Slider Thân Ảo -->
                <Border Background="#1C1C1C" CornerRadius="5" Padding="6" Margin="0,0,0,8" BorderBrush="#7C4DFF" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="1. VISUAL DECOY:" FontWeight="Bold" Foreground="#B388FF" FontSize="11"/>
                        <TextBlock Text="{Binding VisualSliderInfo}" Foreground="#E0E0E0" FontSize="10" Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <Button Content="📥 Import visual slider (Ctrl+C)" Command="{Binding ImportVisualCommand}" Background="#651FFF" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Chế độ Desync -->
                <TextBlock Text="2. HITBOX SEPARATION:" FontWeight="Bold" Foreground="#FFD54F" FontSize="11" Margin="0,4,0,4"/>
                <ComboBox SelectedIndex="{Binding DesyncMode}" Margin="0,0,0,8" Height="26">
                    <ComboBoxItem Content="🎯 Stationary hitbox (Stationary Point)"/>
                    <ComboBoxItem Content="↔️ Parallel hitbox (Parallel Offset ΔX, ΔY)"/>
                    <ComboBoxItem Content="⚡ Single Quantum Slider (Sub-pixel seam jump)"/>
                </ComboBox>

                <!-- Tuỳ chỉnh vị trí / Offset -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X position / offset:" VerticalAlignment="Center" Foreground="White"/>
                    <Slider Grid.Column="1" Value="{Binding StationaryX}" Minimum="0" Maximum="512" SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StationaryX, StringFormat=\{0:F0\}}" Foreground="#FFD54F" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Y position / offset:" VerticalAlignment="Center" Foreground="White"/>
                    <Slider Grid.Column="1" Value="{Binding StationaryY}" Minimum="0" Maximum="384" SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StationaryY, StringFormat=\{0:F0\}}" Foreground="#FFD54F" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Thời gian & Duration -->
                <TextBlock Text="3. START &amp; DURATION:" FontWeight="Bold" Foreground="#80CBC4" FontSize="11" Margin="0,8,0,4"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="2" Background="White" Foreground="Black" Text="{Binding TimeCode}" ToolTip="Start time (ms)"/>
                    <TextBox Grid.Column="1" Margin="2" Background="White" Foreground="Black" Text="{Binding Duration}" ToolTip="Slider duration (ms)"/>
                </Grid>

                <!-- Nút Inject -->
                <Button Content="▶ INJECT QUANTUM DESYNC SLIDER" Click="Inject_Click" 
                        Background="#FFB300" Foreground="Black" FontWeight="Bold" Height="42" Margin="0,15,0,0"/>
            </StackPanel>

            <!-- Khung Preview Playfield -->
            <Border Grid.Column="1" Background="#121212" CornerRadius="6" Padding="6">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>